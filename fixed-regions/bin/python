#!/usr/bin/env bash
set -euo pipefail
XEE_REPO="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -n "${XEE_PYTHON:-}" ]]; then exec "$XEE_PYTHON" "$@"; fi
if [[ "${XEE_USE_SYSTEM:-0}" == 1 ]]; then exec python3 "$@"; fi
exec pixi run --frozen --manifest-path "$XEE_REPO/runtime/CombinedLimit/pixi.toml" python "$@"
