#!/usr/bin/env bash
set -euo pipefail
XEE_REPO="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -n "${XEE_COMBINE:-}" ]]; then exec "$XEE_COMBINE" "$@"; fi
if [[ "${XEE_USE_SYSTEM:-0}" == 1 ]]; then exec combine "$@"; fi
exec pixi run --frozen --manifest-path "$XEE_REPO/runtime/CombinedLimit/pixi.toml" combine "$@"
