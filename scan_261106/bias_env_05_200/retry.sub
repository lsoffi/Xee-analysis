executable = retry.sh
arguments = $(mass) $(model) $(inj) $(seed)
output = logs/retry_$(seed).out
error = logs/retry_$(seed).err
log = logs/retry.events.log
request_cpus = 1
request_memory = 1800MB
request_disk = 1GB
+JobFlavour = "espresso"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""
queue mass,model,inj,seed from retry.txt
